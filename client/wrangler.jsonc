{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atmemo-client",
  "compatibility_date": "2026-11-14",
  "routes": [{ "pattern": "atmemo.afabl.fyi", "custom_domain": true }],
  "workers_dev": false,
  // Vite のビルド成果物を静的アセットとして配信する
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
